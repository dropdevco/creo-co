# Public — safe to expose in the browser bundle (Vite requires this prefix)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Server-side only — set these in Vercel project settings too, never prefix VITE_
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# The passcode typed into the sign-in bar at /edit to unlock the toolbar.
# Pick something memorable but not guessable — a short phrase beats a PIN.
EDIT_PASSCODE=

# Random 32+ byte secret for signing session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
